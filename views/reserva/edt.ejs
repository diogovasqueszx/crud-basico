<%-include('../cabecalho.ejs')%>
    <h1>Editar Reserva</h1>
    <div>
        <a href="/reserva/lst">Listar</a>
    </div>
    <div>
        <form method="post" enctype="multipart/form-data">

            <label>Hóspede:</label>
            <select name="hospede" id="hospede">
                <option value="">selecione</option>
                <%Hospedes.forEach(function(hospede){%>
                    <option value='<%=hospede.id%>'
                    <%=(Reserva.hospede && hospede.id.toString() === Reserva.hospede.toString())?'selected':''%>>
                    <%=hospede.nome%></option>
                <%})%>
            </select><br>
            <label>Quarto:</label>
            <select name="quarto" id="quarto">
                <option value="">selecione</option>
                <%Quartos.forEach(function(quarto){%>
                    <option value='<%=quarto.id%>'
                    <%=(Reserva.quarto && quarto.id.toString() === Reserva.quarto.toString())?'selected':''%>>
                    Nº <%=quarto.numero%></option>
                <%})%>
            </select><br>
            <label>Funcionário responsável:</label>
            <select name="funcionario" id="funcionario">
                <option value="">selecione</option>
                <%Funcionarios.forEach(function(funcionario){%>
                    <option value='<%=funcionario.id%>'
                    <%=(Reserva.funcionario && funcionario.id.toString() === Reserva.funcionario.toString())?'selected':''%>>
                    <%=funcionario.nome%></option>
                <%})%>
            </select><br>
            <label>Tipo de Quarto:</label>
            <select name="tipoQuarto" id="tipoQuarto">
                <option value="Comum" <%=(Reserva.tipoQuarto==='Comum')?'selected':''%>>Comum</option>
                <option value="Luxo" <%=(Reserva.tipoQuarto==='Luxo')?'selected':''%>>Luxo</option>
                <option value="Suíte" <%=(Reserva.tipoQuarto==='Suíte')?'selected':''%>>Suíte</option>
            </select><br>
            <label>Data de Entrada:</label>
            <input type="date" name="dataEntrada" value="<%=Reserva.dataEntrada.toISOString().split('T')[0]%>" required><br>
            <label>Data de Saída:</label>
            <input type="date" name="dataSaida" value="<%=Reserva.dataSaida.toISOString().split('T')[0]%>" required><br>
            <label>Trocar foto:</label>
            <input type="file" id="foto" name="foto" required><br>
            <button type="submit">Salvar</button>

        </form>
    </div>

    <%-include('../rodape.ejs')%>
