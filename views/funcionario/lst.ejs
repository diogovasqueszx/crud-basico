<%-include('../cabecalho.ejs')%>
    <h1>Funcionários</h1>
    <div>
        <form action="/funcionario/lst" method="post">
            <input type="text" name="filtro" id="" placeholder="digite o nome">
            <button type="submit">Pesquisar</button>
        </form>
    </div>
    <a href="/funcionario/add">+ Funcionário</a>
    <table>
        <tr>
            <td>Nome</td>
            <td>CPF</td>
            <td>Cargo</td>
            <td>Telefone</td>
            <td>Ações</td>
        </tr>

        <%for (const {id, nome, cpf, cargo, telefone} of Funcionarios) {%>
            <tr>
                <td><%=nome%></td>
                <td><%=cpf%></td>
                <td><%=cargo%></td>
                <td><%=telefone%></td>
                <td><a href="/funcionario/edt/<%=id%>">Editar</a>
                    <a href="/funcionario/del/<%=id%>">Excluir</a>
                </td>
            </tr>
            <%}%>
    </table>
    <%-include('../rodape.ejs')%>
